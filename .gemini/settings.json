      "query-builder": {"enabled": true},
      "section-writer": {"enabled": true},
      "methodical-enhancer": {"enabled": true},
      "visualization-planner": {"enabled": true},
      "document-assembler": {"enabled": true},
      "reviewer": {"enabled": true},
      "editor": {"enabled": true}
    }
  }
}

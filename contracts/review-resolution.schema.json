{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/lecture-builder/contracts/review-resolution.schema.json",
  "title": "Review finding resolution map",
  "type": "object",
  "required": ["schema_version", "resolutions"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["review_type", "finding_id", "status", "action", "target_location"],
        "properties": {
          "review_type": {"type": "string", "enum": ["scientific", "pedagogical"]},
          "finding_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["resolved", "deferred", "rejected"]},
          "action": {"type": "string", "minLength": 5},
          "target_location": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

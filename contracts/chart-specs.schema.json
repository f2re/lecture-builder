{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/lecture-builder/contracts/chart-specs.schema.json",
  "title": "Deterministic chart specifications",
  "type": "object",
  "required": ["schema_version", "lecture_number", "charts"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "lecture_number": {"type": "integer", "minimum": 1},
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chart_id", "figure_id", "section_id", "question_number", "title",
          "caption", "alt_text", "purpose", "chart_type", "data_policy",
          "data_source_ids", "claim_ids", "evidence_ids", "x_axis", "y_axis",
          "status"
        ],
        "properties": {
          "chart_id": {"type": "string", "pattern": "^chart:[A-Za-z0-9_.:-]+$"},
          "figure_id": {"type": "string", "pattern": "^fig:[A-Za-z0-9_.:-]+$"},
          "section_id": {"type": "string", "pattern": "^q\\d+$"},
          "question_number": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
          "title": {"type": "string", "minLength": 3},
          "caption": {"type": "string", "minLength": 10},
          "alt_text": {"type": "string", "minLength": 10},
          "purpose": {"type": "string", "minLength": 10},
          "chart_type": {
            "type": "string",
            "enum": ["line", "bar", "scatter", "profile", "contour", "heatmap", "hodograph"]
          },
          "data_policy": {"type": "string", "enum": ["source_bound", "schematic"]},
          "data_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "x_axis": {"$ref": "#/$defs/axis"},
          "y_axis": {"$ref": "#/$defs/axis"},
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "x", "y"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "x": {"type": "array", "minItems": 1, "items": {"type": ["number", "string"]}},
                "y": {"type": "array", "minItems": 1, "items": {"type": "number"}},
                "source_id": {"type": ["string", "null"]},
                "evidence_id": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "grid": {
            "type": ["object", "null"],
            "properties": {
              "x": {"type": "array", "minItems": 2, "items": {"type": "number"}},
              "y": {"type": "array", "minItems": 2, "items": {"type": "number"}},
              "z": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "array", "minItems": 2, "items": {"type": "number"}}
              }
            },
            "required": ["x", "y", "z"],
            "additionalProperties": false
          },
          "schematic_note": {"type": ["string", "null"]},
          "transformation": {"type": ["string", "null"]},
          "output_path": {
            "type": ["string", "null"],
            "pattern": "^output/figures/chart_[a-z0-9-]+\\.(?:png|svg)$"
          },
          "data_hash": {"type": ["string", "null"], "pattern": "^(?:sha256:)?[a-f0-9]{64}$"},
          "asset_hash": {"type": ["string", "null"], "pattern": "^(?:sha256:)?[a-f0-9]{64}$"},
          "status": {"type": "string", "enum": ["planned", "generated", "verified", "omitted"]}
        },
        "allOf": [
          {
            "if": {"properties": {"data_policy": {"const": "source_bound"}}},
            "then": {
              "properties": {
                "data_source_ids": {"minItems": 1},
                "evidence_ids": {"minItems": 1}
              }
            }
          },
          {
            "if": {"properties": {"data_policy": {"const": "schematic"}}},
            "then": {"required": ["schematic_note"]}
          },
          {
            "if": {"properties": {"chart_type": {"enum": ["contour", "heatmap"]}}},
            "then": {"required": ["grid"]},
            "else": {"required": ["series"]}
          },
          {
            "if": {"properties": {"status": {"enum": ["generated", "verified"]}}},
            "then": {"required": ["output_path", "asset_hash"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "required": ["label", "scale"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "scale": {"type": "string", "enum": ["linear", "log", "categorical"]},
        "invert": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/lecture-builder/contracts/extracted-fragments.schema.json",
  "title": "Exact source fragments",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["fragment_id", "source_id", "question_ids", "exact_fragment", "document_hash", "location", "location_status"],
    "properties": {
      "fragment_id": {"type": "string", "pattern": "^frag_[A-Za-z0-9_.:-]+$"},
      "source_id": {"type": "string", "pattern": "^src_[A-Za-z0-9_.-]+$"},
      "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
      "exact_fragment": {"type": "string", "minLength": 5},
      "context_before": {"type": ["string", "null"]},
      "context_after": {"type": ["string", "null"]},
      "document_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
      "location": {
        "type": "object",
        "properties": {
          "page": {"type": ["integer", "null"], "minimum": 1},
          "page_label": {"type": ["string", "null"]},
          "section": {"type": ["string", "null"]},
          "paragraph": {"type": ["integer", "null"], "minimum": 1},
          "offset_start": {"type": ["integer", "null"], "minimum": 0},
          "offset_end": {"type": ["integer", "null"], "minimum": 0}
        },
        "additionalProperties": false
      },
      "location_status": {"type": "string", "enum": ["verified", "approximate", "unavailable"]},
      "matched_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "has_formula": {"type": "boolean"},
      "has_definition": {"type": "boolean"},
      "extraction_method": {"type": "string"},
      "extraction_notes": {"type": "string"}
    },
    "additionalProperties": true
  }
}

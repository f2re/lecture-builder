{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/lecture-builder/contracts/figures-index.schema.json",
  "title": "Lecture figure index",
  "type": "object",
  "required": [
    "schema_version",
    "lecture_number",
    "total_figures",
    "figures"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "lecture_number": {
      "type": "integer",
      "minimum": 1
    },
    "total_figures": {
      "type": "integer",
      "minimum": 0
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "figure_id",
          "number",
          "title",
          "caption",
          "alt_text",
          "type",
          "section",
          "section_number",
          "purpose",
          "status",
          "placeholder"
        ],
        "properties": {
          "figure_id": {
            "type": "string",
            "pattern": "^fig:[A-Za-z0-9_.:-]+$"
          },
          "number": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "caption": {
            "type": "string",
            "minLength": 5
          },
          "alt_text": {
            "type": "string",
            "minLength": 5
          },
          "type": {
            "type": "string",
            "enum": [
              "diagram",
              "chart",
              "map",
              "comparison",
              "timeline",
              "concept-map",
              "scientific-illustration"
            ]
          },
          "section": {
            "type": "string",
            "pattern": "^q\\d+$"
          },
          "section_number": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 5
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "generated",
              "verified",
              "omitted"
            ]
          },
          "data_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "prompt_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^prompt:[A-Za-z0-9_.:-]+$"
          },
          "placeholder": {
            "type": "string"
          },
          "asset_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "chart_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^chart:[A-Za-z0-9_.:-]+$"
          },
          "asset_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "chart"
                }
              }
            },
            "then": {
              "required": [
                "chart_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "generated",
                    "verified"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "asset_path"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}

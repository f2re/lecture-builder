{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/lecture-builder/contracts/run-manifest.schema.json",
  "title": "Hash-based pipeline manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "platform",
    "config_hash",
    "literature_hash",
    "prompt_version",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "enum": [
        "antigravity",
        "codex",
        "gemini"
      ]
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "literature_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_version": {
      "type": "string"
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "updated_at",
          "input_hash",
          "outputs",
          "output_hashes"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "failed",
              "blocked",
              "in_progress"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

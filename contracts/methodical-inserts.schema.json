{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/lecture-builder/contracts/methodical-inserts.schema.json",
  "title": "Methodical inserts for a lecture",
  "type": "object",
  "required": ["schema_version", "lecture_number", "inserts"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "lecture_number": {"type": "integer", "minimum": 1},
    "inserts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "insert_id",
          "section_id",
          "question_number",
          "type",
          "learning_functions",
          "title",
          "body",
          "rationale",
          "placement",
          "required",
          "word_count"
        ],
        "properties": {
          "insert_id": {"type": "string", "pattern": "^ins:[A-Za-z0-9_.:-]+$"},
          "section_id": {"type": "string", "pattern": "^q\\d+$"},
          "question_number": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
          "type": {
            "type": "string",
            "enum": [
              "key_idea",
              "mnemonic",
              "thematic_example",
              "formula_reading",
              "common_mistake",
              "self_check",
              "comparison",
              "professional_context",
              "visual_cue"
            ]
          },
          "learning_functions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["understand", "remember", "apply", "self_check", "transfer"]
            }
          },
          "title": {"type": "string", "minLength": 3},
          "body": {"type": "string", "minLength": 10},
          "rationale": {"type": "string", "minLength": 10},
          "placement": {
            "type": "object",
            "required": ["strategy"],
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "after_heading",
                  "after_paragraph",
                  "after_formula",
                  "after_subsection",
                  "before_micro_conclusion"
                ]
              },
              "subsection_number": {"type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$"},
              "anchor_text": {"type": ["string", "null"]},
              "anchor_hash": {"type": ["string", "null"], "pattern": "^(?:sha256:)?[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          },
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "hypothetical": {"type": "boolean"},
          "required": {"type": "boolean"},
          "word_count": {"type": "integer", "minimum": 1, "maximum": 180}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/lecture-builder/contracts/search-results.schema.json",
  "title": "Discovered source candidates",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["source_id", "question_ids", "query", "rank", "title", "url", "metadata_status", "provenance"],
    "properties": {
      "source_id": {"type": "string", "pattern": "^src_[A-Za-z0-9_.-]+$"},
      "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
      "query": {"type": "string", "minLength": 2},
      "language": {"type": "string"},
      "rank": {"type": "integer", "minimum": 1},
      "title": {"type": "string", "minLength": 2},
      "url": {"type": "string", "format": "uri"},
      "doi": {"type": ["string", "null"]},
      "snippet": {"type": ["string", "null"]},
      "source_class": {"type": "string"},
      "metadata_status": {"type": "string", "enum": ["verified", "partial", "unverified"]},
      "provenance": {
        "type": "object",
        "required": ["method"],
        "properties": {
          "method": {"type": "string"},
          "discovered_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
